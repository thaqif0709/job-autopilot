{
  "name": "job-autopilot",
  "version": "0.1.0",
  "private": true,
  "description": "Local job finder, ranker and application drafter that stops before Submit",
  "type": "module",
  "bin": {
    "jobs": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "jobs": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "dotenv": "^18.0.8",
    "imapflow": "^2.5.8",
    "mailparser": "^3.10.0",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
